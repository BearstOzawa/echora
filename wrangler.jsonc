{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "echora-web",
  "compatibility_date": "2026-07-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "echora-web.lili.uno",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
